<!-- controllableled.ejs -->

<!-- Other head content -->

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

<!-- jquery.wheelcolorpicker.js -->
<link rel="stylesheet" href="styles/wheelcolorpicker.dark.css">
<script src="https://cdn.socket.io/4.0.1/socket.io.min.js"></script>
<script src="scripts/jquery.wheelcolorpicker.js"></script>


<!-- controllableled.ejs -->

<div class="col col-auto mb-4">
    <div class="card gradient-color shadow-lg border-radius card-text h-100">
        <div class="card-body">
            <h5 class="card-title">Color Picker Control</h5>
            <p>
                <input id="color-block" type="text" value="#ffffff" data-wheelcolorpicker="" data-wcp-format="css" data-wcp-layout="block" data-wcp-cssclass="color-block" data-wcp-autoresize="true">
            </p>
            <p>
                Selected color:
                <span class="color-preview-box"></span>
                <span class="color-preview-text"></span>
                <span class="color-preview-alpha"></span>
            </p>
            <p>
                Currently set color:
                <span class="currently-set-color-box"></span>
                <span class="currently-set-color-text"></span>
            </p>
            <button id="setColorBtn" class="btn btn-primary position-absolute bottom-0 mb-4">Set Color</button>
        </div>
    </div>
</div>

<style type="text/css">
    .jQWCP-wWidget.jQWCP-block.color-block{
        box-shadow: none;
    }
    .color-block {
        background: none;
        border: none;
        overflow: hidden;
        min-width: 220px;
    }
    .color-preview-box,
    .currently-set-color-box {
        display: inline-block;
        width: .75em;
        height: .75em;
        vertical-align: middle;
        padding: 2px;
        background-clip: content-box;
    }
    .jQWCP-wWheel{
        /* width: 250px;
        height: 100px; */
    }
</style>

<!-- controllableled.ejs -->

<script type="text/javascript">
    $(function () {
        // Initialize Socket.io connection
        const socket = io();

        // Listen for color updates from the server
        socket.on('color-update', function (data) {
        // Update the "currently set color" block in real-time
        updateCurrentlySetColor(rgbToHex(data.color.r, data.color.g, data.color.b));
        });
        $('#color-block').on('colorchange', function (e) {
            var color = $(this).wheelColorPicker('value');
            var alpha = $(this).wheelColorPicker('color').a;
            $('.color-preview-box').css('background-color', color);
            $('.color-preview-text').text(color);
        });

        // Set Color button click event
        $('#setColorBtn').on('click', function () {
            // Get the selected color and apply your logic here
            var selectedColor = $('#color-block').wheelColorPicker('value');
            console.log('Selected Color:', selectedColor);

            // Get the IP address (replace this with your logic to retrieve the IP)
            var ipAddress = "192.168.0.195";

            // Convert the color to the format expected by the ESP32
            var rgbColor = {
                r: parseInt(selectedColor.substring(1, 3), 16),
                g: parseInt(selectedColor.substring(3, 5), 16),
                b: parseInt(selectedColor.substring(5, 7), 16)
            };

            // Create the message object
            var message = {
                color: rgbColor,
                ip: ipAddress
            };

            // Output the generated message to the console
            console.log('Generated Message:', message);

            // Make an AJAX request to set the color on the server
            $.ajax({
                type: 'POST',
                url: '/devices/controllable-led/set-color',
                contentType: 'application/json', // Set content type to JSON
                data: JSON.stringify(message),
                success: function (response) {
                    console.log(response);
                },
                error: function (error) {
                    console.error(error);
                }
            });
        });

        // Update the "currently set color" block
        function updateCurrentlySetColor(color) {
            $('.currently-set-color-box').css('background-color', color);
            $('.currently-set-color-text').text(color);
        }

        // Make a GET request to get the currently set color
        $.get('/devices/controllable-led/get-color', function (data) {
            var currentlySetColor = data.color;
            console.log('Currently Set Color:', currentlySetColor);

            // Convert the RGB color to hex
            var hexColor = rgbToHex(currentlySetColor.r, currentlySetColor.g, currentlySetColor.b);

            // Update the "currently set color" block
            updateCurrentlySetColor(hexColor);
        });

        // Function to convert RGB to hex
        function rgbToHex(r, g, b) {
            return '#' + componentToHex(r) + componentToHex(g) + componentToHex(b);
        }

        // Function to convert component to hex
        function componentToHex(c) {
            var hex = c.toString(16);
            return hex.length == 1 ? '0' + hex : hex;
        };
    });

</script>
