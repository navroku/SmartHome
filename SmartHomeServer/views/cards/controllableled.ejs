<!-- controllableled.ejs -->

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

<!-- jquery.wheelcolorpicker.js -->
<link rel="stylesheet" href="styles/wheelcolorpicker.dark.css" />
<script src="https://cdn.socket.io/4.0.1/socket.io.min.js"></script>
<script src="scripts/jquery.wheelcolorpicker.js"></script>

<div class="col col-auto mb-4">
  <div class="card gradient-color shadow-lg border-radius card-text h-100">
    <div class="card-body">
      <h5 class="card-title">Color Picker Control</h5>
      <p>
        <input
          id="color-block"
          type="text"
          value="#ffffff"
          data-wheelcolorpicker=""
          data-wcp-format="rgb"
          data-wcp-layout="block"
          data-wcp-cssclass="color-block"
          data-wcp-autoresize="false"
        />
      </p>
      <p class="user-select-none">
        Selected color:
        <span class="color-preview-box"></span>
        <span class="color-preview-text"></span>
        <span class="color-preview-alpha"></span>
      </p>
      <p class="user-select-none">
        Currently set color:
        <span class="currently-set-color-box"></span>
        <span class="currently-set-color-text"></span>
      </p>
      <p class="d-flex justify-content-end">
        <button
          id="setColorBtn"
          class="btn btn-primary bottom-0 mb-4"
        >
          Set Color
        </button>
      </p>
    </div>
  </div>
</div>

<style type="text/css">
  .jQWCP-wWidget.jQWCP-block.color-block {
    box-shadow: none;
  }
  .color-block {
    background: none;
    border: none;
    overflow: hidden;
    /* min-width: 220px; */
  }
  .color-preview-box,
  .currently-set-color-box {
    display: inline-block;
    width: 0.75em;
    height: 0.75em;
    vertical-align: middle;
    padding: 2px;
    background-clip: content-box;
  }
  .jQWCP-wWheel {
    display: flex;
  }
  .btn-link-style {
    color: #007bff;
    text-decoration: underline;
    cursor: pointer;
    background-color: transparent;
    border: none;
    padding: 0;
    text-decoration: none;
  }
</style>

<script type="text/javascript">
  $(function () {
    const socket = io();
  
    function sendColorToESP32(color) {
      const ipAddress = "192.168.0.195";
      const rgbValues = color
        .substring(4, color.length - 1)
        .split(",")
        .map((value) => parseInt(value.trim(), 10));
  
      const message = {
        color: {
          r: rgbValues[0],
          g: rgbValues[1],
          b: rgbValues[2],
        },
        ip: ipAddress,
      };
  
      console.log("Generated Message:", message);
  
      $.ajax({
        type: "POST",
        url: "/devices/controllable-led/set-color",
        contentType: "application/json",
        data: JSON.stringify(message),
        success: function (response) {
          console.log(response);
        },
        error: function (error) {
          console.error(error);
        },
      });
    }
  
    // Initial update with the currently set color
    socket.on('controllable_led-update', function (data) {
      const color = data.color;
      
      // Log the received data
      console.log('Received controllable_led-update:', data);
  
      // Update currently set color
      $(".currently-set-color-box").css("background-color", `rgb(${color.r}, ${color.g}, ${color.b})`);
      $(".currently-set-color-text").text(`rgb(${color.r}, ${color.g}, ${color.b})`);
    });
  
    $("#color-block").on("colorchange", function () {
      const color = $(this).wheelColorPicker("value");
      
      // Update preview color
      $(".color-preview-box").css("background-color", color);
      $(".color-preview-text").text(color);
    });
  
    $("#setColorBtn").on("click", function () {
      const selectedColor = $("#color-block").wheelColorPicker("value");
      console.log("Selected Color:", selectedColor);
      sendColorToESP32(selectedColor);
    });
  });
  
  </script>
  