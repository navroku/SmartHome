<!-- controllableled.ejs -->

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

<!-- jquery.wheelcolorpicker.js -->
<link rel="stylesheet" href="styles/wheelcolorpicker.dark.css" />
<script src="scripts/jquery.wheelcolorpicker.js"></script>
<script src="https://cdn.socket.io/4.0.1/socket.io.min.js"></script>


<div class="col col-auto mb-4">
  <div class="card gradient-color shadow-lg border-radius card-text h-100">
    <div class="card-body">
      <h5 class="card-title">Color Picker Control</h5>
      <p>
        <input
          id="color-block"
          type="text"
          value="#ffffff"
          data-wheelcolorpicker=""
          data-wcp-format="rgb"
          data-wcp-layout="block"
          data-wcp-cssclass="color-block"
          data-wcp-autoresize="false"
        />
      </p>
      <p class="user-select-none">
        Selected color:
        <span class="color-preview-box"></span>
        <span class="color-preview-text"></span>
        <span class="color-preview-alpha"></span>
      </p>
      <p class="user-select-none">
        Current color:
        <span class="currently-set-color-box"></span>
        <span class="currently-set-color-text"></span>
        <span class="currently-set-color-alpha"></span>
      </p>
      <p class="d-flex justify-content-between">
        <button
          id="turnOffBtn"
          class="btn btn-secondary mb-4"
        >
          Turn Off
        </button>
        <button
          id="setColorBtn"
          class="btn btn-primary mb-4"
        >
          Set Color
        </button>
      </p>
      <% if (status === 'unavailable') { %>
        <p>Status: <span id="status-<%= ip %>" class="text-danger"><%= status %></span></p>
      <% } else { %>
        <p id="status-<%= ip %>" style="display: none;"><%= status %></p>
        <p id="message-<%= ip %>"></p>
      <% } %>
      <% if (user.isAdmin) { %>
        <button class="btn btn-danger btn-sm" onclick="removeDevice('<%= ip %>')" location.reload(true);>Remove</button>
      <% } %>
    </div>
  </div>
</div>

<style type="text/css">
  .jQWCP-wWidget.jQWCP-block.color-block {
    box-shadow: none;
  }
  .color-block {
    background: none;
    border: none;
    overflow: hidden;
    /* min-width: 220px; */
  }
  .color-preview-box,
  .currently-set-color-box {
    display: inline-block;
    width: 0.75em;
    height: 0.75em;
    vertical-align: middle;
    padding: 2px;
    background-clip: content-box;
  }
  .jQWCP-wWheel {
    display: flex;
  }
  .btn-link-style {
    color: #007bff;
    text-decoration: underline;
    cursor: pointer;
    background-color: transparent;
    border: none;
    padding: 0;
    text-decoration: none;
  }
</style>

<script type="text/javascript">
  $(function () {
    const ipAddress = "<%= ip %>";
    const socket = io();

    socket.on('connect', () => {
      console.log('Socket.io connected');
      // Make a GET request to retrieve the latest color information
      $.get("/devices/controllable-led/get-color", function (data) {
        console.log('Received color information from server:', data);
        // Filter the data based on the ipAddress
        const filteredData = data[ipAddress];
        if (filteredData) {
          colorUpdate(filteredData);
        }
      });
    });

    socket.on('disconnect', () => {
      console.log('Socket.io disconnected');
    });

    // Function to update the color preview
    function colorUpdate(data) {
      if (ipAddress === data.ip) {
        const color = `rgb(${data.color.r}, ${data.color.g}, ${data.color.b})`;
        updateColorPreview(color);
      }
    }

    // Function to update the color preview
    function updateColorPreview(color) {
      $(".currently-set-color-box").css("background-color", color);
      $(".currently-set-color-text").text(color);
    }
    // Listen for the color-update event
    socket.on('color-update', function (data) {
      if (Array.isArray(data)) {
        data.forEach(colorUpdate);
      } else {
        // Filter the data based on the ipAddress
        const filteredData = data[ipAddress];
        if (filteredData) {
          colorUpdate(filteredData);
        }
      }
    });

    function sendColorToESP32(color) {
      const rgbValues = color
        .substring(4, color.length - 1)
        .split(",")
        .map((value) => parseInt(value.trim(), 10));

      const message = {
        color: {
          r: rgbValues[0],
          g: rgbValues[1],
          b: rgbValues[2],
        },
        ip: ipAddress,
      };

      console.log("Generated Message:", message);

      $.ajax({
        type: "POST",
        url: "/devices/controllable-led/set-color",
        contentType: "application/json",
        data: JSON.stringify(message),
        success: function (response) {
          console.log(response);
        },
        error: function (error) {
          console.error(error);
        },
      });
    }

    $("#turnOffBtn").on("click", function () {
      const offColor = "rgb(0, 0, 0)";
      $(".color-preview-box").css("background-color", offColor);
      $(".color-preview-text").text(offColor);
      sendColorToESP32(offColor);
    });

    $("#color-block").on("colorchange", function () {
      const color = $(this).wheelColorPicker("value");

      $(".color-preview-box").css("background-color", color);

      // Format RGB values with spaces
      const rgbValues = color
        .substring(4, color.length - 1)
        .split(",")
        .map((value) => parseInt(value.trim(), 10));

      const formattedColorText = `rgb(${rgbValues.join(', ')})`;
      $(".color-preview-text").text(formattedColorText);
    });

    $("#setColorBtn").on("click", function () {
      const selectedColor = $("#color-block").wheelColorPicker("value");
      console.log("Selected Color:", selectedColor);
      sendColorToESP32(selectedColor);
    });
    // Set the initial color of the color picker to white (rgb(255, 255, 255))
    $("#color-block").wheelColorPicker("value", "rgb(255, 255, 255)");
  });
</script>
