<!-- Include JustGage library and Raphael library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/raphael/2.1.4/raphael-min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/justgage/1.2.9/justgage.min.js"></script>

<!-- Your Express.js Smart Home Dashboard HTML Template -->
<div class="col col-md-4 mb-4">
    <div class="card gradient-color shadow-lg border-radius card-text">
        <div class="card-body ">
            <h5 class="card-title">Flower Soil Moisture</h5>

            <!-- Include the div for the soil moisture gauge -->
            <div id="soilMoistureGauge"></div>

            <p class="card-text">
                The soil moisture for your flower is: <strong><span id="soilMoistureValue">--</span>%</strong>
            </p>
        </div>
    </div>
</div>

<!-- Include script for updating the soil moisture gauge -->
<script>
    // Function to update soil moisture gauge
    function updateSoilMoistureGauge(value) {
        soilMoistureGauge.refresh(value);
        document.getElementById("soilMoistureValue").innerText = value.toFixed(2);
    }

    // Initialize soil moisture gauge
    var soilMoistureGauge = new JustGage({
        id: "soilMoistureGauge",
        value: 0,
        min: 0,
        max: 100,
        title: "Soil Moisture",
        gaugeWidthScale: 0.5,
        counter: true,
        relativeGaugeSize: true,
        levelColors: ["#66cc66"],
        valueFontColor: "#9b9ca7", // Change this to your desired text color
        valueFont: "10px Arial",
        symbol: "%", // Add the unit symbol
    });

    // Example usage: Update the soil moisture gauge with a new value
    // You can replace this value with the actual data from your soil moisture sensor
    updateSoilMoistureGauge(75);
</script>
