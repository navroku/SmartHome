<!-- temperature_humidity.ejs -->

<!-- Include JustGage library and Raphael library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/raphael/2.1.4/raphael-min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/justgage/1.2.9/justgage.min.js"></script>
<script src="https://cdn.socket.io/4.0.1/socket.io.min.js"></script>
<!-- Set the IP address globally -->
<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<!-- Your Express.js Smart Home Dashboard HTML Template -->
<div class="col col-md-4 mb-4">
  <div class="card gradient-color shadow-lg border-radius card-text">
    <div class="card-body">
      <h5 class="card-title">Environment Information</h5>
      <div id="temperatureGauge-<%= ip %>"></div>
      <div id="humidityGauge-<%= ip %>"></div>
      <p class="card-text">
        <strong>Temperature:</strong> <span id="temperatureValue-<%= ip %>">--</span> °C<br>
        <strong>Humidity:</strong> <span id="humidityValue-<%= ip %>">--</span> %
      </p>
      <p id="status-<%= ip %>" style="display: none;"><%= status %></p>
      <p id="message-<%= ip %>"></p>
      <% if (user.isAdmin) { %>
        <button class="btn btn-danger btn-sm" onclick="removeDevice('<%= ip %>')" location.reload(true);>Remove</button>
      <% } %>
      
    </div>
  </div>
</div>

<!-- Include script for updating gauges -->
<script>
  $(function () {
    // Function to update temperature gauge
    const ipAddress = "<%= ip %>"; // Change this to your ESP32 IP address
    function updateTemperatureGauge(value) {
      temperatureGauge.refresh(value);
      document.getElementById("temperatureValue-<%= ip %>").innerText = value.toFixed(2);
    }

    // Function to update humidity gauge
    function updateHumidityGauge(value) {
      humidityGauge.refresh(value);
      document.getElementById("humidityValue-<%= ip %>").innerText = value.toFixed(2);
    }

    // Function to update status and message
    function updateStatus(newStatus, newMessage) {
      const statusElement = document.getElementById("status-" + ipAddress);
      const messageElement = document.getElementById("message-" + ipAddress);

      if (statusElement && messageElement) {
        statusElement.innerText = newStatus;

        if (newStatus === 'unavailable') {
          messageElement.innerText = newMessage || 'Device is currently unavailable';
          messageElement.classList.add('text-danger');
        } else {
          messageElement.innerText = '';
          messageElement.classList.remove('text-danger');
        }
      }
    }

    // Initialize temperature gauge
    var temperatureGauge = new JustGage({
      id: "temperatureGauge-<%= ip %>",
      value: 0,
      min: -20,
      max: 40,
      title: "Temperature",
      gaugeWidthScale: 0.5,
      counter: true,
      relativeGaugeSize: true,
      levelColors: ["#990000"],
      valueFontColor: "#9b9ca7", // Change this to your desired text color
      valueFont: "10px Arial",
      symbol: "°C", // Add the unit symbol
    });

    // Initialize humidity gauge
    var humidityGauge = new JustGage({
      id: "humidityGauge-<%= ip %>",
      value: 0,
      min: 0,
      max: 100,
      title: "Humidity",
      gaugeWidthScale: 0.5,
      counter: true,
      relativeGaugeSize: true,
      levelColors: ["#009999"],
      valueFontColor: "#9b9ca7", // Change this to your desired text color
      valueFont: "10px Arial",
      symbol: "%", // Add the unit symbol
    });
    
    // Socket.io connection to receive MQTT data
    const socket = io();
    socket.on('connect', () => {
      console.log('Socket.io connected (temperature_humidity)');
      // Make a GET request to retrieve the latest color information
      $.get("/devices/temperature_humidity/get-temperature-humidity", function (data) {
        const filteredData = data[ipAddress];
        if (filteredData) {
          updateEnvironmentInfo(filteredData);
        }
      });
    });
    socket.on('temperature_humidity-update', function (data) {
      if (data.ip === ipAddress) {
        updateEnvironmentInfo(data);
      }
    });

    function updateEnvironmentInfo(data) {
      // Implement logic to update the gauges with the received data
      const temperature = data.temperature || 0;
      const humidity = data.humidity || 0;
      const status = data.status || 'unknown'; // Replace 'unknown' with a default value
      const message = data.message || ''; // Add the message property to your data

      // Example usage
      updateTemperatureGauge(temperature);
      updateHumidityGauge(humidity);
      updateStatus(status, message);
    }
  });
</script>