<!-- views/index.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Smart Home</title>
  <link rel="stylesheet" href="/styles.css">
  <% layout('navbar') %>
</head>
<body>
  <div class="container">
      <!-- Include the navbar -->
    
    <h1>Welcome <%= user.username %></h1>
    

    <!-- Display user status (admin or user) -->
    <p>User Status: <%= user.isAdmin === 1 ? 'Admin' : 'User' %></p>
    <!-- Your main content here -->

    <!-- Logout form -->
    <form action="/logout" method="post">
      <button type="submit">Logout</button>
    </form>
    <a href="/register" class="register-button">Register new user</a>
  </div>
</body>
</html>
